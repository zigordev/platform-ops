{
  "name": "platform-ops",
  "private": true,
  "version": "0.1.0",
  "description": "Operations and infrastructure for platform environments",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"scripts/**/*.{mjs,json}\" \".github/**/*.{json,yml,yaml}\" \"docker/**/*.{json,yml,yaml}\" \"docs/**/*.md\" \"infra/**/*.md\" \"*.{json,md}\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \"scripts/**/*.{mjs,json}\" \".github/**/*.{json,yml,yaml}\" \"docker/**/*.{json,yml,yaml}\" \"docs/**/*.md\" \"infra/**/*.md\" \"*.{json,md}\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "test:secrets:gitleaks": "bash ./scripts/precommit-gitleaks.sh",
    "check:shell": "bash ./scripts/check-shell.sh",
    "check:workflows": "bash ./scripts/check-workflows.sh",
    "check:compose": "bash ./scripts/check-compose.sh",
    "check:terraform": "bash ./scripts/check-terraform-fmt.sh",
    "check:kit": "node ./scripts/check-kit-parity.mjs --self",
    "check:alerts": "node ./scripts/check-alert-wiring.mjs",
    "kit:manifest": "node ./scripts/kit-manifest.mjs",
    "ci:quality:local": "npm run format:check && npm run typecheck && npm run test:cov && npm run test:shell && npm run check:hooks",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local",
    "check:hooks": "npm run test:secrets:gitleaks && npm run check:shell && npm run check:workflows && npm run check:compose && npm run check:terraform && npm run check:kit && npm run check:alerts",
    "local:up": "bash ./scripts/local-stack-up-ops.sh",
    "local:down": "bash ./scripts/local-stack-down-ops.sh",
    "local:reset": "bash ./scripts/local-stack-down-ops.sh --volumes",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:shell": "bats test/shell",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dashboards": "node packages/dashboards/generate.ts",
    "check:licences": "node ./scripts/check-licences.mjs .",
    "check:secret-expiry": "node ./scripts/check-secret-expiry.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "bats": "^1.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prom-client": "^15.1.3",
    "source-map-js": "^1.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "web-vitals": "^6.2.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  }
}
