{
  "uid": "gpool-funnel",
  "title": "gpool funnel",
  "description": "The life of a pool: created, people invited, invitations accepted, predictions submitted — and the emails that carry each invitation, followed from gpool asking to the relay accepting.",
  "tags": ["business", "gpool", "pools"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "expr": "max by (job, version) (service_build_info{job=\"gpool-api\"}) unless on (job, version) deploy:version_seen:max3d",
          "interval": "1m"
        },
        "titleFormat": "Deploy · {{job}} {{version}}",
        "textFormat": "",
        "tagKeys": "job,version",
        "useValueForTime": false
      }
    ]
  },
  "templating": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Estate",
      "tags": ["estate"],
      "asDropdown": true,
