{
  "uid": "email-delivery",
  "title": "Email delivery",
  "description": "Every email the estate sends, by the app that asked for it and the template: requested, sent, failed, dead-lettered and how long it took.",
  "tags": ["business", "email"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "expr": "max by (job, version) (service_build_info{job=\"notifications-api\"}) unless on (job, version) deploy:version_seen:max3d",
          "interval": "1m"
        },
        "titleFormat": "Deploy · {{job}} {{version}}",
        "textFormat": "",
        "tagKeys": "job,version",
        "useValueForTime": false
      }
    ]
  },
  "templating": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Estate",
      "tags": ["estate"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
