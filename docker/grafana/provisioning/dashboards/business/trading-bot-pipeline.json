  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backtests · 7 days",
      "description": "Backtest requests that finished, whatever came of them. A zero week means the data-readiness trigger never fired, not that the strategies are idle.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_runs_total[7d])) or vector(0)",
          "legendFormat": "runs",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backtests that failed · 7 days",
      "description": "Runs that ended in an error instead of a score. Each one is a configuration nobody learned anything about; the reason is in the log at the bottom.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_runs_total{outcome=\"error\"}[7d])) or vector(0)",
          "legendFormat": "failed",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signals emitted · 7 days",
      "description": "Entry signals the strategies raised while replaying history. This is the raw output of the pipeline before any risk rule has had a say.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_emitted_signals_total[7d])) or vector(0)",
          "legendFormat": "signals",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Simulated trades · 7 days",
      "description": "Trades those signals actually opened and closed. The gap to the signals is everything the risk profile threw away.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_simulated_trades_total[7d])) or vector(0)",
          "legendFormat": "trades",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Signals per simulated trade · 7 days",
      "description": "How many signals it took to get one trade. Near 1 the risk rules are waving almost everything through; climbing into double figures they are rejecting nearly everything, and the strategy is being tested on a handful of trades whose score means little.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_emitted_signals_total[7d])) / sum(increase(trading_bot_research_backtesting_simulated_trades_total[7d]))",
          "legendFormat": "signals per trade",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Binance weight used",
      "description": "Request weight spent in the last minute against the cap Binance enforces. Past the cap Binance bans the IP for minutes at a time and market-data stops feeding everything downstream, so the orange band is the place to slow down. This is a reading of the last scrape rather than a total, so it shows nothing at all while the local stack is down.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_market_data_binance_rest_used_weight_1m) / max(trading_bot_market_data_binance_rest_limit_weight_1m)",
          "legendFormat": "used",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backtest runs by outcome",
      "description": "Completed runs over time. success and error are the only two outcomes the service reports, and both are created at zero on start, so a gap is silence rather than a missing series.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (increase(trading_bot_research_backtesting_runs_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replay, signals and trades",
      "description": "The three stages of one backtest at the same scale: klines pulled out of ClickHouse, signals raised from them, trades simulated from those. Klines with no signals means the strategy never triggered; signals with no trades means the risk rules refused every one.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_replayed_klines_total[$__rate_interval]))",
          "legendFormat": "klines replayed",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_emitted_signals_total[$__rate_interval]))",
          "legendFormat": "signals",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(trading_bot_research_backtesting_simulated_trades_total[$__rate_interval]))",
          "legendFormat": "simulated trades",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Mode",
      "description": "paper simulates every fill locally. live places orders on the Binance account with real money, and the trade panels below stop being a rehearsal. Read the whole of this dashboard through this tile, and read it as unknown rather than safe when it is blank: the tile is the last scrape, so it empties whenever execution is not running.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "live", "color": "red", "index": 0 },
                "1": { "text": "paper", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_execution_paper_mode_enabled)",
          "legendFormat": "mode",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Trades opened",
      "description": "Positions the execution service opened, by side. Long and short should both appear; only one side over a whole range usually means the promoted strategy is one-directional rather than that the other side is broken. The service starts both counters at zero for every loaded promotion, so a flat zero means no trade, not no metric.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (side) (increase(trading_bot_execution_trades_opened_total[$__rate_interval]))",
          "legendFormat": "{{side}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Trades closed, by reason",
      "description": "Why each position ended. takeProfit is the plan working; a wall of stopLoss or riskExit says the promoted configuration is wrong for the market it is trading, and reversal means the strategy changed its mind rather than the levels being hit. The service starts both counters at zero for every loaded promotion, so a flat zero means no trade, not no metric.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (close_reason) (increase(trading_bot_execution_trades_closed_total[$__rate_interval]))",
          "legendFormat": "{{close_reason}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Binance weight against its cap",
      "description": "Weight spent, the self-imposed target market-data throttles itself to, and the hard cap Binance enforces. The used line riding the target is the limiter doing its job; used crossing the limit is a ban, and every stage of this pipeline goes quiet behind it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_market_data_binance_rest_used_weight_1m)",
          "legendFormat": "used",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_market_data_binance_rest_target_weight_1m)",
          "legendFormat": "target",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_market_data_binance_rest_limit_weight_1m)",
          "legendFormat": "cap",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "The last backtest of each configuration",
      "description": "One row per strategy, pair, timeframe and risk profile, holding only its most recent run — rerunning a configuration replaces its row instead of adding one, so this is a standings table and never a history. Sorted by the promotion score, which is what decides whether a configuration is ever traded. A high score on a handful of trades is worth less than the number suggests; read it against the signals-per-trade tile. Reads once the local stack is running an image built from main.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": { "mode": "palette-classic" },
