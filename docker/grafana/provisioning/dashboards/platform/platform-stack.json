          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(tempo_distributor_spans_received_total[$__rate_interval]))",
          "legendFormat": "received by Tempo",
          "range": true,
          "instant": false,
          "exemplar": false
        }
