  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LCP p75 · 1 hour",
      "description": "Largest Contentful Paint. Good is under 2.5 s.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"LCP\"}[1h])))",
          "legendFormat": "LCP",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INP p75 · 1 hour",
      "description": "Interaction to Next Paint. Good is under 200 ms, and gpool is a click-heavy app, so this is the vital to watch.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"INP\"}[1h])))",
          "legendFormat": "INP",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CLS p75 · 1 hour",
      "description": "Cumulative Layout Shift. Good is under 0.1.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(rum_layout_shift_score_bucket{job=\"gpool-web\"}[1h])))",
          "legendFormat": "CLS",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Page views · 24 hours",
      "description": "Full page loads the browser reported. Moving between pools is a route change, not a page view, and is counted below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rum_navigations_total{job=\"gpool-web\", navigation_type=\"Page View\"}[24h])) or vector(0)",
          "legendFormat": "views",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Client errors · 24 hours",
      "description": "Script errors and rejected promises players hit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rum_errors_total{job=\"gpool-web\"}[24h])) or vector(0)",
          "legendFormat": "errors",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "CSP violations · 24 hours",
      "description": "Scripts or resources the policy did not allow. Needs gpool#283, which is what gives gpool-web a policy and a report endpoint.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(csp_violations_total{job=\"gpool-web\"}[24h])) or vector(0)",
          "legendFormat": "violations",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LCP p75 by release",
      "description": "Compare a release with the one before it. The release label arrives with gpool#283; before it every visit falls into one series. Hover a dot to open the render trace.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, release) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"LCP\"}[$__rate_interval])))",
          "legendFormat": "{{release}}",
          "range": true,
          "instant": false,
          "exemplar": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "INP and TTFB p75 by release",
      "description": "Responsiveness and server response, by release.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, release) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"INP\"}[$__rate_interval])))",
          "legendFormat": "INP · {{release}}",
          "range": true,
          "instant": false,
          "exemplar": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, release) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"TTFB\"}[$__rate_interval])))",
          "legendFormat": "TTFB · {{release}}",
          "range": true,
          "instant": false,
          "exemplar": true
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "What players did",
      "description": "gpool declares its own event names, so these are the product steps rather than raw clicks. Most frequent first.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "", "countRows": false },
        "sortBy": [{ "displayName": "Count", "desc": true }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": { "interaction_type": "Event", "Value": "Count" }
          }
        }
      ],
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (interaction_type) (increase(rum_interactions_total{job=\"gpool-web\", interaction_type=~\"Pool Created|User Invited|Access Requested|Invitation Accepted|Invitation Accept Failed|Access Request Accepted|Access Request Accept Failed\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Frustration",
      "description": "Rage clicks, dead clicks, slow page loads and excessive scrolling. A dead click on a pool page is usually a button that needed a sign-in.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (frustration_type) (increase(rum_frustrations_total{job=\"gpool-web\"}[$__rate_interval]))",
          "legendFormat": "{{frustration_type}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CSP violations by directive",
      "description": "Which rule of the policy was broken. Needs gpool#283.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (directive) (increase(csp_violations_total{job=\"gpool-web\"}[$__rate_interval]))",
          "legendFormat": "{{directive}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Pages",
      "description": "Views and largest paint per page over the time range. Pool ids are collapsed to :id, so every pool shares one row. other means a path that is not in the route allow-list.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Views" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "", "countRows": false },
        "sortBy": [{ "displayName": "Views", "desc": true }]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": { "page": "Page", "Value #A": "Views", "Value #B": "LCP p75" }
          }
        }
      ],
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (page) (increase(rum_navigations_total{job=\"gpool-web\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, page) (rate(rum_performance_seconds_bucket{job=\"gpool-web\", metric_name=\"LCP\"}[$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "How far a session gets",
      "description": "Pages visited in one session. gpool is a several-page app, so a median of one means players arrive and leave without opening a pool.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
