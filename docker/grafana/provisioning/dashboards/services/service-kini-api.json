{
  "uid": "service-kini-api",
  "title": "kini-api",
  "description": "The kini API: the lottery feeds it scrapes and how each one fails, the weekly pool sync, invitation emails, the live pool socket, its routes, runtime and failures.",
  "tags": ["services", "service", "kini"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "expr": "max by (job, version) (service_build_info{job=\"kini-api\"}) unless on (job, version) deploy:version_seen:max3d",
          "interval": "1m"
        },
        "titleFormat": "Deploy · {{job}} {{version}}",
        "textFormat": "",
        "tagKeys": "job,version",
        "useValueForTime": false
      }
    ]
  },
  "templating": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Estate",
      "tags": ["estate"],
      "asDropdown": true,
