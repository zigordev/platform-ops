  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health",
      "description": "What the service says about itself on /health: ok, degraded (an optional dependency is down) or error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "error", "color": "red", "index": 0 },
                "1": { "text": "degraded", "color": "orange", "index": 1 },
                "2": { "text": "ok", "color": "green", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(service_health_status{job=\"sity-web\"})",
          "legendFormat": "health",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scraped",
      "description": "Whether Prometheus reaches the service at all. Down here and silent everywhere else means the process is gone.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red", "index": 0 },
                "1": { "text": "up", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(up{job=\"sity-web\"})",
          "legendFormat": "up",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Release",
      "description": "The release the running process reports. Deploys are marked on every graph below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (version) (service_build_info{job=\"sity-web\"})",
          "legendFormat": "{{version}}",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Page views · 24 hours",
      "description": "Page views the browser reported. sity is one page, so this is how often someone opened the scene.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rum_navigations_total{job=\"sity-web\", navigation_type=\"Page View\"}[24h])) or vector(0)",
          "legendFormat": "views",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Client errors · 24 hours",
      "description": "Script errors and rejected promises the browser reported. RUM starts before the scene, so a machine that cannot open a WebGL context is counted here instead of failing silently.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rum_errors_total{job=\"sity-web\"}[24h])) or vector(0)",
          "legendFormat": "errors",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "CSP violations · 24 hours",
      "description": "The policy is served report-only, so nothing was actually blocked. A count here is what would break once it is enforced.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(csp_violations_total{job=\"sity-web\"}[24h])) or vector(0)",
          "legendFormat": "violations",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "By route, as Fastify labels it. A file that exists is counted under /*; unmatched is everything the router had no route for, which is both the page handed back for any other path and every 404. /rum/events and /rum/csp are the browser reporting back.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(http_requests_total{job=\"sity-web\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Responses that were not 2xx",
      "description": "By route and status. Every 404 lands on unmatched rather than on /*, and means a file that is not there — usually an asset a stale page still asks for. 400, 403 or 429 on /rum is a beacon the ingest refused; the reason is in Rejected beacons below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route, status) (rate(http_requests_total{job=\"sity-web\", status!~\"2..\"}[$__rate_interval]))",
          "legendFormat": "{{route}} · {{status}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "By route. /* covers everything from the 4 kB page to the compressed megabyte of bundle, so its p95 says more about what was asked for than about the server. The /rum posts are small and constant: a rise there is the machine.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"sity-web\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Core Web Vitals p75",
      "description": "Real visits. Good is under 2.5 s for LCP, 200 ms for INP and 800 ms for TTFB.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, metric_name) (rate(rum_performance_seconds_bucket{job=\"sity-web\", metric_name=~\"LCP|INP|TTFB|FCP\"}[$__rate_interval])))",
          "legendFormat": "{{metric_name}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Page load p75",
      "description": "How long the page takes to be ready and then fully loaded. This is where a heavier scene or a new asset shows up first.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le, metric_name) (rate(rum_performance_seconds_bucket{job=\"sity-web\", metric_name=~\"DOMContentLoaded|Load\"}[$__rate_interval])))",
          "legendFormat": "{{metric_name}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Layout shift p75",
      "description": "Cumulative Layout Shift, unitless. Good is under 0.1. The canvas fills the viewport, so a shift here means something moved around it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(rum_layout_shift_score_bucket{job=\"sity-web\"}[$__rate_interval])))",
          "legendFormat": "CLS",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Client errors",
      "description": "By type. A machine that cannot open a WebGL context throws while the scene module loads, and RUM is started first, so it arrives here as a JavaScript Error rather than as a blank page nobody hears about.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 21, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (error_type) (rate(rum_errors_total{job=\"sity-web\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Frustration",
      "description": "Rage clicks, dead clicks, slow page loads and excessive scrolling. Only buttons and links are watched, so this is the control panel and never the canvas: a click on the scene itself is not recorded at all.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 21, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (frustration_type) (rate(rum_frustrations_total{job=\"sity-web\"}[$__rate_interval]))",
          "legendFormat": "{{frustration_type}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Rejected beacons",
      "description": "Beacons the ingest threw away, by reason. Read this first when someone used sity and the browser panels are still empty: cross_origin means the page was opened on a host name the server does not answer to, rate_limited that one browser sent too many, malformed that the batch did not parse.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "palette-classic" },
