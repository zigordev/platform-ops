  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health",
      "description": "What the service says about itself on /health: ok, degraded (an optional dependency is down) or error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "error", "color": "red", "index": 0 },
                "1": { "text": "degraded", "color": "orange", "index": 1 },
                "2": { "text": "ok", "color": "green", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(service_health_status{job=\"trading-bot-research-backtesting\"})",
          "legendFormat": "health",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
