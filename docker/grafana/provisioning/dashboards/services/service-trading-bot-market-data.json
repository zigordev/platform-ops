          "legendFormat": "pairs",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Binance weight used",
      "description": "Share of the REQUEST_WEIGHT ceiling spent in the current minute. The local limiter aims at 90% of it; past the ceiling Binance answers 429 and then bans the address.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": { "x": 16, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_market_data_binance_rest_used_weight_1m{job=\"trading-bot-market-data\"}) / max(trading_bot_market_data_binance_rest_limit_weight_1m{job=\"trading-bot-market-data\"})",
          "legendFormat": "used",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Store failures · 1 hour",
      "description": "Klines and trades that reached the service and could not be written to ClickHouse. Each one is a hole in the history a backtest will read.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
