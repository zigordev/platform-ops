    {
      "id": 13,
      "type": "timeseries",
      "title": "Binance REST requests",
      "description": "Calls to Binance by endpoint and outcome. Klines are the backfill; aggTrades is the trade gap repair.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
