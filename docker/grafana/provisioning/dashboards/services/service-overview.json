    {
      "type": "dashboards",
      "title": "Frontend",
      "tags": ["frontend"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "dashboards",
      "title": "Platform",
      "tags": ["platform"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
