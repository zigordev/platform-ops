{
  "uid": "service-trading-bot-execution",
  "title": "trading-bot-execution",
  "description": "The Rust service that reads the live kline and trade stream, evaluates the promoted strategies and opens and closes positions. The one panel that matters is the mode: paper means every trade is simulated, live means the Binance account is being used for real. trading-bot is local only: no deploy, no production scrape job. Health, dependencies and release come from trading-bot#158 and stay empty until it merges.",
  "tags": ["services", "service", "trading-bot"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "expr": "max by (job, version) (service_build_info{job=\"trading-bot-execution\"}) unless on (job, version) deploy:version_seen:max3d",
          "interval": "1m"
        },
        "titleFormat": "Deploy · {{job}} {{version}}",
        "textFormat": "",
        "tagKeys": "job,version",
        "useValueForTime": false
      }
    ]
  },
  "templating": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Estate",
      "tags": ["estate"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "dashboards",
      "title": "Services",
      "tags": ["services"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "dashboards",
      "title": "Frontend",
      "tags": ["frontend"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "dashboards",
      "title": "Platform",
      "tags": ["platform"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "dashboards",
      "title": "Business",
      "tags": ["business"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    },
    {
      "type": "link",
      "title": "Runbooks",
      "url": "https://github.com/zigordev/platform-ops/tree/main/docs/runbooks",
      "targetBlank": true,
      "icon": "doc",
      "tags": [],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Mode",
      "description": "paper simulates every fill locally. live places orders on the Binance account with real money. Leaving paper is a page.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "live", "color": "red", "index": 0 },
                "1": { "text": "paper", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_execution_paper_mode_enabled{job=\"trading-bot-execution\"})",
          "legendFormat": "mode",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Health",
      "description": "What the service says about itself on /health: ok, degraded (an optional dependency is down) or error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "error", "color": "red", "index": 0 },
                "1": { "text": "degraded", "color": "orange", "index": 1 },
                "2": { "text": "ok", "color": "green", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(service_health_status{job=\"trading-bot-execution\"})",
          "legendFormat": "health",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scraped",
      "description": "Whether Prometheus reaches the service at all. Down here and silent everywhere else means the process is gone.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red", "index": 0 },
                "1": { "text": "up", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(up{job=\"trading-bot-execution\"})",
          "legendFormat": "up",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Release",
      "description": "The release the running process reports. Deploys are marked on every graph below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {},
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (version) (service_build_info{job=\"trading-bot-execution\"})",
          "legendFormat": "{{version}}",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Promotion loaded",
      "description": "Whether a promoted execution configuration is actually loaded. Without one the service runs and trades nothing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "none", "color": "text", "index": 0 },
                "1": { "text": "loaded", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_execution_active_promotion_loaded{job=\"trading-bot-execution\"})",
          "legendFormat": "promotion",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Market data lag",
      "description": "Klines and trades published and not yet read. The strategies see the market this far behind.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(kafka:consumer_group_lag:sum{redpanda_group=\"trading-bot-execution-market-data-v1\"}) or vector(0)",
          "legendFormat": "lag",
          "range": false,
          "instant": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Dependencies",
      "description": "Each dependency as /health last saw it. A dependency that was never probed has no row.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "color-text" }, "inspect": false },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red", "index": 0 },
                "1": { "text": "up", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "", "countRows": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": { "component": "Dependency", "Value": "State" }
          }
        }
      ],
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (component) (service_component_up{job=\"trading-bot-execution\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "exemplar": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mode over time",
      "description": "One line, and it should never leave 1. A step down to 0 is the moment a live promotion took effect.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(trading_bot_execution_paper_mode_enabled{job=\"trading-bot-execution\"})",
          "legendFormat": "paper",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Consumer lag by topic",
      "description": "How far behind the kline and aggregate-trade topics the service is. Lag that only grows means the evaluation loop is slower than the market.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka:consumer_group_lag:sum{redpanda_group=\"trading-bot-execution-market-data-v1\"}",
          "legendFormat": "{{redpanda_topic}}",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Paper trades closed",
      "description": "Positions the simulator closed, by the reason it closed them: a target, a stop or the end of the promotion. From the logs.",
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (close_reason) (count_over_time({app=\"trading-bot-execution\"} | json | event=\"paper_trade.closed\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{close_reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Control-plane refreshes",
      "description": "How often the service re-reads its promotions and analysis settings. A flat zero means the refresh loop stopped and the configuration is frozen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(trading_bot_execution_refresh_total{job=\"trading-bot-execution\"}[$__rate_interval]))",
          "legendFormat": "refreshes",
          "range": true,
          "instant": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Failing traces",
      "description": "The latest traces with a span in error. Select a trace id to open it.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "", "countRows": false }
      },
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"trading-bot-execution\" && status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Trades and reconciliation",
      "description": "Every simulated trade closed, and every time reconciliation found no free balance to work with.",
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"trading-bot-execution\"} | json | event=~\"paper_trade.closed|reconciliation.no_free_balance\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Errors and warnings",
      "description": "Error and warning lines, newest first. A line with a trace id has a button that opens the trace.",
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"trading-bot-execution\"} | json | level=~\"error|warn\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
