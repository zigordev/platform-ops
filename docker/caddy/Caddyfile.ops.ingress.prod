{
  servers {
    metrics
  }
}

:9180 {
  metrics /metrics
}

{$GPOOL_WEB_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /metrics
  respond @metrics 404

  reverse_proxy gpool-web:3001
}

{$GPOOL_API_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /metrics
  respond @metrics 404

  reverse_proxy gpool-api:3000
}

{$KINI_WEB_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /metrics
  respond @metrics 404

  reverse_proxy kini-web:3001
}

{$KINI_API_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /metrics
  respond @metrics 404

  reverse_proxy kini-api:3000
}

{$CV_WEB_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /metrics
  respond @metrics 404

  reverse_proxy cv-web:3001
}

{$OPS_GRAFANA_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip
  reverse_proxy grafana:3000
}

{$OPS_TOLGEE_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip
  reverse_proxy tolgee:8080
}

{$OPS_UNLEASH_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip
  reverse_proxy unleash:4242
}

{$OPS_OPENBAO_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @metrics path /v1/sys/metrics*
  respond @metrics 404

  reverse_proxy openbao:8200
}
